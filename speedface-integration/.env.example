# SpeedFace-V5L Integration — Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# ── Phase 1/2 — Device connection ────────────────────────────────────────────

# DEVICE_IP: IPv4 address of the SpeedFace-V5L on your LAN
DEVICE_IP=

# DEVICE_PORT: TCP port (ZKTeco default: 4370)
DEVICE_PORT=4370

# DEVICE_COMM_KEY: Device comm password (integer; 0 = no password)
DEVICE_COMM_KEY=0

# DEVICE_TIMEOUT: Connection timeout in seconds
DEVICE_TIMEOUT=10

# ── Phase 3 — API server ──────────────────────────────────────────────────────

# API_KEY: Secret token for API authentication (Bearer token)
# Generate a strong random key: python -c "import secrets; print(secrets.token_hex(32))"
# NEVER commit this value to Git.
API_KEY=

# API_HOST: Host to bind the API server (default: 127.0.0.1 = localhost only)
# Set to 0.0.0.0 only if you need LAN access AND have firewall protection.
API_HOST=127.0.0.1

# API_PORT: Port for the API server
API_PORT=8000

# API_RELOAD: Enable uvicorn auto-reload in development (true/false)
API_RELOAD=false

# ── Phase 3 — Background sync worker ─────────────────────────────────────────

# SYNC_INTERVAL_SECONDS: How often the background worker syncs from the device
# Default: 300 (every 5 minutes). Minimum: 10.
SYNC_INTERVAL_SECONDS=300

# ── Optional ──────────────────────────────────────────────────────────────────

# DB_PATH: Override default SQLite database path
# Default: data/speedface.db (relative to project root)
# DB_PATH=
